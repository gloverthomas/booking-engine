# Copy to .env.local. Never commit real values.

# --- Who operates this site (shown on every page and in the legal pages) ---
# Until these are set the pages show "to be confirmed" and the site asks search engines not to index it.
ENTITY_LEGAL_NAME=
ENTITY_ABN=
ENTITY_TRADING_NAME=
ENTITY_ADDRESS=

# --- Public URLs ---
SITE_URL=https://hairmate.world
APP_URL=https://app.hairmate.world

# --- Contact form ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL="HairMate <hello@hairmate.world>"
CONTACT_TO_EMAIL=
# Optional bot check (Cloudflare Turnstile). If the secret is set, the form requires a token.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Error monitoring (optional) ---
# SENTRY_DSN=
