xt-muted" style="color:#5B4A3F;font-size:12px;line-height:18px;padding:16px 28px 0;text-align:center">Ryan Kennedy Hairdressing</td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

