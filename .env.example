# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking_engine
# Optional (defaults shown)
# BUSINESS_TIMEZONE=Australia/Melbourne

# --- Integrations: each workstream reads only its own keys and must fail with a clear message if missing ---
# APP_URL=http://localhost:3000
# ENCRYPTION_KEY=            # openssl rand -base64 32
# OWNER_EMAILS=ryan@example.com
# BETTER_AUTH_SECRET=        # openssl rand -base64 32
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# RESEND_API_KEY=
# EMAIL_FROM="Ryan Kennedy <bookings@example.com>"
# SMS_PROVIDER=console       # console | clicksend | twilio
# SMS_SENDER_ID=
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- SMS (Twilio, optional alternative to ClickSend) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_PROVIDER=console is for dev only: it logs full SMS bodies, including manage links.

# --- Public booking page ---
# PUBLIC_EMBED_ORIGINS=https://www.example.com.au   # sites allowed to iframe /book
# PUBLIC_TRUSTED_PROXY_HOPS=1

# --- MCP server (/api/mcp) ---
# MCP_API_TOKEN_HASH=        # sha256 hex of the bearer token (comma-separated to rotate)
# MCP_OWNER_ID=owner
# MCP_MONEY_TOOLS_ENABLED=false
# MCP_MAX_MONEY_CENTS=20000
# MCP_MAX_MONEY_DAILY_CENTS=50000
# MCP_RATE_LIMIT_PER_MIN=60
# MCP_WRITE_RATE_LIMIT_PER_MIN=10

# --- Error monitoring (Sentry). Off until a DSN is set. Events are scrubbed of emails, phones and booking links. ---
# SENTRY_DSN=                    # server + worker
# NEXT_PUBLIC_SENTRY_DSN=        # browser (same project's DSN is fine)
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG= / SENTRY_PROJECT= / SENTRY_AUTH_TOKEN=   # only to upload source maps at build time

# Google Maps Embed API browser key for the map on the location step (restrict it to your domains). Optional: without it only "Open in Maps" links show.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
